<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Recommand.Client.AspNetCore</PackageId>
        <Version>0.4.2</Version>
        <Authors>Techworx</Authors>
        <Company>Techworx</Company>
        <Description>ASP.NET Core integration for Recommand.Client: a one-line MapRecommandWebhook endpoint extension that reads the raw body, verifies the X-Signature HMAC, deduplicates on X-Idempotency-Key, parses the polymorphic payload, and dispatches to a strongly-typed handler delegate.</Description>
        <PackageTags>recommand;peppol;einvoicing;webhooks;aspnetcore</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright © Techworx</Copyright>

        <RepositoryUrl>https://github.com/TechworxBV/recommand-client</RepositoryUrl>
        <PackageProjectUrl>https://github.com/TechworxBV/recommand-client</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Recommand.Client.AspNetCore.Tests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\Recommand.Client\Recommand.Client.csproj" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

</Project>
